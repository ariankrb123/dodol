# URL endpoint that returns a fresh destination access token for each send
MENU_TOKEN_URL=
MENU_CLIENT_ID=
MENU_CLIENT_SECRET=
# Optional request body forwarded to the token endpoint as JSON.
# Defaults to { "client_id": "...", "client_secret": "..." }
MENU_TOKEN_BODY=
# Destination menu endpoint
MENU_API_URL=https://menutam.ir/api/v1/public/menu
